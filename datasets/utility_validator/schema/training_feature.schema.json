{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Training Feature",
  "type": "object",
  "required": [
    "sample_id",
    "label_id",
    "task_id",
    "candidate_id",
    "dataset_source",
    "scenario_type",
    "candidate_strategy",
    "source_scopes",
    "target_scopes",
    "risk_tags",
    "dependency_notes",
    "moved_block_count",
    "movement_distance_summary",
    "global_prefix_tokens_or_chars",
    "subgroup_prefix_tokens_or_chars",
    "estimated_cache_gain",
    "hard_warning_count",
    "whether_label_is_utility_verified",
    "is_utility_preserved",
    "failure_type"
  ],
  "properties": {
    "sample_id": {"type": "string"},
    "label_id": {"type": "string"},
    "task_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "dataset_source": {"type": "string"},
    "scenario_type": {"type": "string"},
    "candidate_strategy": {"type": "string"},
    "source_scopes": {"type": "array", "items": {"type": "string"}},
    "target_scopes": {"type": "array", "items": {"type": "string"}},
    "risk_tags": {"type": "array", "items": {"type": "string"}},
    "dependency_notes": {"type": "array", "items": {"type": "string"}},
    "moved_block_count": {"type": "integer"},
    "movement_distance_summary": {"type": "object"},
    "global_prefix_tokens_or_chars": {"type": "integer"},
    "subgroup_prefix_tokens_or_chars": {"type": "integer"},
    "estimated_cache_gain": {"type": "number"},
    "hard_warning_count": {"type": "integer"},
    "whether_label_is_utility_verified": {"type": "boolean"},
    "is_utility_preserved": {"type": ["boolean", "null"]},
    "failure_type": {"type": "string"}
  },
  "additionalProperties": true
}
